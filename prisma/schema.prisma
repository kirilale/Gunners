// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  username          String   @unique
  displayName       String?
  profilePhoto      String?
  locationCountry   String?
  locationCity      String?
  favoritePlayer    String?
  supporterSince    Int?
  bio               String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?

  // Relations
  checkIns          CheckIn[]
  badges            Badge[]
  predictions       Prediction[]
  achievements      Achievement[]
  userStats         UserStats?
  userSettings      UserSettings?
  sessions          Session[]

  @@index([email])
  @@index([username])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Match {
  id                  String   @id @default(cuid())
  apiFixtureId        Int      @unique
  season              Int
  competitionId       Int
  competitionName     String
  opponentTeamId      Int
  opponentName        String
  opponentLogo        String?
  homeAway            String   // HOME or AWAY
  venueName           String?
  venueCity           String?
  matchDate           DateTime
  kickoffTime         DateTime
  matchStatus         String   // TBD, NS, 1H, HT, 2H, FT, etc.
  matchState          String   // SCHEDULED, CHECK_IN_OPEN, LIVE, POST_MATCH_PROCESSING, COMPLETED, ARCHIVED
  arsenalScore        Int?
  opponentScore       Int?
  result              String?  // WIN, DRAW, LOSS
  matchEvents         Json?    // Array of goals, cards, substitutions
  checkInOpenTime     DateTime?
  checkInCloseTime    DateTime?
  matchFinishedAt     DateTime? // Timestamp when match status became FT/AET/PEN
  badgesGenerated     Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  checkIns            CheckIn[]
  badges              Badge[]
  predictions         Prediction[]

  @@index([apiFixtureId])
  @@index([matchDate])
  @@index([matchState])
  @@index([season])
}

model CheckIn {
  id                  String   @id @default(cuid())
  userId              String
  matchId             String
  locationCountry     String
  locationCity        String
  locationLat         Float?
  locationLng         Float?
  statusMessage       String?
  photoUrl            String?
  checkInTimestamp    DateTime @default(now())
  createdAt           DateTime @default(now())

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  match               Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([userId, matchId])
  @@index([userId])
  @@index([matchId])
  @@index([locationCountry])
}

model Badge {
  id                  String   @id @default(cuid())
  userId              String
  matchId             String
  badgeType           String   // STANDARD, DERBY, CLEAN_SHEET, HIGH_SCORING, etc.
  badgeDesignUrl      String?
  matchResult         String
  matchScore          String
  competition         String
  checkInLocation     String
  matchNumber         Int      // User's sequence number
  earnedTimestamp     DateTime @default(now())
  createdAt           DateTime @default(now())

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  match               Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([userId, matchId])
  @@index([userId])
  @@index([matchId])
}

model Prediction {
  id                        String   @id @default(cuid())
  userId                    String
  matchId                   String
  predictedArsenalScore     Int
  predictedOpponentScore    Int
  predictedFirstScorerId    Int?
  predictedFirstScorerName  String?
  pointsEarned              Int?
  predictionResult          String?  // EXACT, OUTCOME, WRONG
  submittedAt               DateTime @default(now())
  createdAt                 DateTime @default(now())

  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  match                     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([userId, matchId])
  @@index([userId])
  @@index([matchId])
}

model Achievement {
  id                    String   @id @default(cuid())
  userId                String
  achievementType       String
  achievementName       String
  achievementDescription String
  rarity                String   // COMMON, RARE, EPIC, LEGENDARY
  unlockTimestamp       DateTime @default(now())
  progressData          Json?    // For multi-level achievements
  createdAt             DateTime @default(now())

  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([achievementType])
}

model UserStats {
  id                          String   @id @default(cuid())
  userId                      String   @unique
  totalCheckIns               Int      @default(0)
  currentStreak               Int      @default(0)
  longestStreak               Int      @default(0)
  lastCheckInDate             DateTime?
  totalBadges                 Int      @default(0)
  totalAchievements           Int      @default(0)
  totalPredictionPoints       Int      @default(0)
  predictionAccuracyPercentage Float   @default(0)
  fanLevel                    String   @default("BRONZE") // BRONZE, SILVER, GOLD, PLATINUM
  luckyCharmPercentage        Float?
  arsenalWinsWhenPresent      Int      @default(0)
  arsenalDrawsWhenPresent     Int      @default(0)
  arsenalLossesWhenPresent    Int      @default(0)
  arsenalWinsWhenAbsent       Int      @default(0)
  arsenalDrawsWhenAbsent      Int      @default(0)
  arsenalLossesWhenAbsent     Int      @default(0)
  countriesCheckedInFrom      Json?    // Array of countries
  citiesCheckedInFrom         Json?    // Array of cities
  updatedAt                   DateTime @updatedAt

  user                        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserSettings {
  id                    String   @id @default(cuid())
  userId                String   @unique
  emailNotifications    Json?    // Object with notification type preferences
  pushNotifications     Json?    // Object with notification type preferences
  quietHoursStart       String?
  quietHoursEnd         String?
  spoilerMode           Boolean  @default(false)
  profileVisibility     String   @default("PUBLIC") // PUBLIC, FRIENDS, PRIVATE
  updatedAt             DateTime @updatedAt

  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
